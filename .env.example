APP_NAME="wrapbiz-register-kbank"
APP_ENV=production
APP_KEY=
# Never true in production (forced off when APP_ENV=production).
APP_DEBUG=false
APP_URL=https://register.example.com

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Laravel's own storage. Must never point at the wrapbiz database.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null
# Must support atomic locks (file, redis, database, memcached); use a shared store (redis) with several app servers.
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Comma-separated IPs/CIDRs of the reverse proxies in front of the app, e.g. 10.0.4.0/24,10.0.5.7
# Needed for per-IP rate limits behind a load balancer. Wildcards (*, **, REMOTE_ADDR), 0.0.0.0/0, ::/0,
# ranges broader than /16 (IPv4) or /32 (IPv6) and IPv6 entries overlapping ::/96, ::ffff:0:0/96,
# ::ffff:0:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001::/23, 2002::/16, fe80::/10, fec0::/10
# or ff00::/8 are rejected: they would let clients spoof their IP. ::1 and fc00::/7 are allowed.
TRUSTED_PROXIES=

# Site-wide cap on credential submissions to the bank (all clients together). Defaults: 20/min, 200/hour.
WRAPBIZ_BANK_LOGINS_PER_MINUTE=20
WRAPBIZ_BANK_LOGINS_PER_HOUR=200

# --- wrapbiz database (bank deployment DB) -------------------------------------
# Login role must be a member of wrapbiz_kbank_registration (EXECUTE on the six
# registration functions only). A non-local database needs sslmode=verify-full (lowercase;
# the server's CA must be trusted, e.g. sslrootcert in WRAPBIZ_DB_URL). require, verify-ca
# and disable are accepted only when WRAPBIZ_DB_HOST is set, every host is localhost,
# 127.0.0.1, ::1 or a unix socket path, and PGHOSTADDR, PGSERVICE and PGSERVICEFILE are
# unset. Local development may use disable. Host, database and username
# must not contain ; ' " \ = or whitespace; the port is 1-65535. Connection options
# (options / server_options in WRAPBIZ_DB_URL) are refused.
WRAPBIZ_DB_HOST=127.0.0.1
WRAPBIZ_DB_PORT=5432
WRAPBIZ_DB_DATABASE=wrapbiz
WRAPBIZ_DB_USERNAME=wrapbiz_register
WRAPBIZ_DB_PASSWORD=
WRAPBIZ_DB_SSLMODE=verify-full

# --- keys (all base64) ----------------------------------------------------------
# X25519 public key of the worker (`wrapbiz-kbank keygen seal`). Public; this app cannot decrypt.
WRAPBIZ_SEAL_PUBLIC_KEY=
# >= 32 random bytes. Must stay the same forever per bank DB: account fingerprints depend on it.
WRAPBIZ_FINGERPRINT_KEY=
# >= 32 random bytes, used to HMAC client IPs for the audit log.
WRAPBIZ_IP_HASH_KEY=
# Ed25519 webhook-signing public keys shown to customers: "<kid>:<base64 32 bytes>,<kid>:<...>"
WRAPBIZ_SIGNING_PUBLIC_KEYS=

# --- KBiz bank flow -------------------------------------------------------------
# Every bank-specific string lives here; the code only knows logical names.
#   KBIZ_API_<n>_PATH     request path on KBIZ_BASE_URL
#   KBIZ_API_<n>_HEADERS  JSON {"Real-Header-Name":"value"} sent as-is
#   KBIZ_API_<n>_FIELDS   JSON {"logical_name":"realKeyName"}; response locations may be dotted paths (a.b.0)
#   KBIZ_API_<n>_VALUES   JSON {"logical_name":"real fixed value"}
#   KBIZ_SELECTOR_<n>     XPath or PCRE (with delimiters) for HTML pages
# Run `php artisan wrapbiz:check-config` after editing; missing items are named.
# Paths may carry a query string; same rules as the worker's loader (no //, #, \, . or .. segments,
# whitespace, or bad %XX escapes). The base URL is an https origin, port 443 only.
KBIZ_BASE_URL=https://bank.example
# Per-request timeout in whole seconds, 1-45 (a whole bank login must fit in the
# register code's 3-minute attempt reservation).
KBIZ_TIMEOUT_SECONDS=20

# n=1 login_page: GET, yields the per-session login token (KBIZ_SELECTOR_1)
KBIZ_API_1_PATH=/placeholder/login-page
KBIZ_API_1_HEADERS='{"X-Placeholder-Agent":"placeholder"}'

# n=2 login_submit: form POST of username/password/token; page contains QR (SELECTOR_2) and its timeout (SELECTOR_3)
#   FIELDS: login_name, login_secret, login_token, command, ui_locale, customer_type, touch_points, app_mode
#   VALUES: command, ui_locale, customer_type, touch_points, app_mode
KBIZ_API_2_PATH=/placeholder/login-submit
KBIZ_API_2_HEADERS='{"X-Placeholder-Agent":"placeholder"}'
KBIZ_API_2_FIELDS='{"login_name":"f_user","login_secret":"f_pass","login_token":"f_token","command":"f_cmd","ui_locale":"f_locale","customer_type":"f_ctype","touch_points":"f_touch","app_mode":"f_app"}'
KBIZ_API_2_VALUES='{"command":"v_cmd","ui_locale":"v_locale","customer_type":"v_ctype","touch_points":"v_touch","app_mode":"v_app"}'

# n=3 approval_status: JSON POST "{}", polled until the app approves or rejects
#   FIELDS: approval_state (dotted response path)   VALUES: state_approved, state_rejected (non-empty, different)
KBIZ_API_3_PATH=/placeholder/approval-status
KBIZ_API_3_HEADERS='{"X-Placeholder-Agent":"placeholder"}'
KBIZ_API_3_FIELDS='{"approval_state":"f_state"}'
KBIZ_API_3_VALUES='{"state_approved":"v_ok","state_rejected":"v_no"}'

# n=4 qr_confirm: form POST after approval; response must match KBIZ_SELECTOR_4
#   FIELDS: qr_timestamp, error_text, ui_locale, command   VALUES: error_text, ui_locale, command
KBIZ_API_4_PATH=/placeholder/qr-confirm
KBIZ_API_4_HEADERS='{"X-Placeholder-Agent":"placeholder"}'
KBIZ_API_4_FIELDS='{"qr_timestamp":"f_ts","error_text":"f_err","ui_locale":"f_locale","command":"f_cmd"}'
KBIZ_API_4_VALUES='{"error_text":"v_err","ui_locale":"v_locale","command":"v_cmd"}'

# n=5 bank_redirect: GET, page carries the hand-off token (KBIZ_SELECTOR_5, capture group 1)
KBIZ_API_5_PATH=/placeholder/redirect
KBIZ_API_5_HEADERS='{"X-Placeholder-Agent":"placeholder"}'

# n=6 validate_session: JSON POST of the hand-off token; session token comes back in a response header
#   FIELDS: handoff_token, session_token_header, profile (dotted path), user_ref, org_id, customer_type
KBIZ_API_6_PATH=/placeholder/validate
KBIZ_API_6_HEADERS='{"X-Placeholder-Agent":"placeholder"}'
KBIZ_API_6_FIELDS='{"handoff_token":"f_handoff","session_token_header":"x-placeholder-token","profile":"f_data.f_profiles.0","user_ref":"f_uref","org_id":"f_org","customer_type":"f_ctype"}'

# n=7 list_accounts: JSON POST with session headers; returns the user's own accounts
#   FIELDS: customer_type, owner_id, user_ref_header, session_user_ref_header, session_auth_header,
#           account_list (dotted path), account_number, account_kind,
#           account_filter, balance_flag, response_language, nickname_kind, owner_kind
#   VALUES: account_filter, balance_flag, response_language, nickname_kind, owner_kind
KBIZ_API_7_PATH=/placeholder/accounts
KBIZ_API_7_HEADERS='{"X-Placeholder-Agent":"placeholder","x-placeholder-app":"v_app"}'
KBIZ_API_7_FIELDS='{"customer_type":"f_ctype","owner_id":"f_owner","user_ref_header":"x-placeholder-uref","session_user_ref_header":"x-placeholder-suref","session_auth_header":"x-placeholder-auth","account_list":"f_data.f_accounts","account_number":"f_no","account_kind":"f_kind","account_filter":"f_filter","balance_flag":"f_bal","response_language":"f_lang","nickname_kind":"f_nick","owner_kind":"f_okind"}'
KBIZ_API_7_VALUES='{"account_filter":"v_filter","balance_flag":"v_bal","response_language":"v_lang","nickname_kind":"v_nick","owner_kind":"v_okind"}'

# Selectors
# 1 login_token  (XPath, n=1 page)       2 qr_image (XPath to the QR <img> src, n=2 page)
# 3 qr_deadline  (XPath, n=2 page; epoch s/ms or duration s/ms)
# 4 qr_confirmed (PCRE that must match the n=4 response)   5 handoff_token (PCRE with a capture group; group 1, n=5 page)
KBIZ_SELECTOR_1='//input[@name="f_token"]/@value'
KBIZ_SELECTOR_2='//img[@id="placeholder-qr"]/@src'
KBIZ_SELECTOR_3='//input[@name="placeholder-deadline"]/@value'
KBIZ_SELECTOR_4='#placeholder-confirmed#'
KBIZ_SELECTOR_5='#placeholder-handoff=([A-Za-z0-9%]+)#'
